# Prismaの接続文字列（Cloud SQL for PostgreSQL）
DATABASE_URL=

# fetchDataが絶対URLを組み立てるために使用（例：http://localhost:3000／Cloud RunのURL）
APP_URL=http://localhost:3000

# Firebase Admin SDK用（セッションCookieの発行・検証）
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Identity Platformのクライアント側SDK設定
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# Anthropic Claude API呼び出し用（サーバー側のみで使用）
ANTHROPIC_API_KEY=
