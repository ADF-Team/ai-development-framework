# Prismaの接続文字列（Cloud SQL for PostgreSQL）
# ローカル開発では `docker compose up -d` で起動するdb（docker-compose.yml参照）に接続する
DATABASE_URL=postgresql://adf:adf@localhost:5433/adf_dev

# fetchDataが絶対URLを組み立てるために使用（例：http://localhost:3000／Cloud RunのURL）
APP_URL=http://localhost:3000

# Firebase Admin SDK用（セッションCookieの発行・検証）
# ローカル開発ではFirebase Auth Emulatorに接続するため、CLIENT_EMAIL/PRIVATE_KEYは空のままでよい
FIREBASE_PROJECT_ID=demo-adf
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

# Identity Platformのクライアント側SDK設定
# ローカル開発ではFirebase Auth Emulatorに接続するため、API_KEY等はダミー値でよい
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=localhost
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-adf
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

# Anthropic Claude API呼び出し用（サーバー側のみで使用）
ANTHROPIC_API_KEY=
