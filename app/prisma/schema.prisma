generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  user
  admin
  system_admin

  @@map("user_role")
}

enum UserStatus {
  active
  disabled

  @@map("user_status")
}

enum OrganizationStatus {
  active
  suspended

  @@map("organization_status")
}

enum StageKey {
  requirements
  design
  implementation
  review
  security
  test
  documentation

  @@map("stage_key")
}

enum ProjectOverallStatus {
  in_progress
  completed

  @@map("project_overall_status")
}

enum ProjectStageStatus {
  not_started
  in_progress
  quality_gate_pending
  completed

  @@map("project_stage_status")
}

model Organization {
  id        String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String             @unique @db.VarChar(255)
  status    OrganizationStatus @default(active)
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz

  users     User[]
  templates Template[]
  projects  Project[]

  @@map("organizations")
}

model User {
  id                  String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId      String     @map("organization_id") @db.Uuid
  identityPlatformUid String     @unique @map("identity_platform_uid") @db.VarChar(128)
  email               String     @unique @db.VarChar(255)
  role                UserRole   @default(user)
  displayName         String?    @map("display_name") @db.VarChar(100)
  status              UserStatus @default(active)
  createdAt           DateTime   @default(now()) @map("created_at") @db.Timestamptz

  organization     Organization      @relation(fields: [organizationId], references: [id])
  templateVersions TemplateVersion[]
  createdProjects  Project[]

  @@index([organizationId])
  @@map("users")
}

// テンプレート（7工程分のパック）そのもの。複数作成できる。publishedAtが非NULLなら公開中。
// titleは現在有効な版（TemplateVersion）のタイトルを都度書き込む非正規化カラム（同一組織内の重複禁止をDB制約で保証するため）
model Template {
  id                        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId            String    @map("organization_id") @db.Uuid
  title                     String    @db.VarChar(255)
  publishedAt               DateTime? @map("published_at") @db.Timestamptz
  sourcePublishedTemplateId String?   @map("source_published_template_id") @db.Uuid
  createdAt                 DateTime  @default(now()) @map("created_at") @db.Timestamptz

  organization        Organization      @relation(fields: [organizationId], references: [id])
  sourceTemplate      Template?         @relation("TemplateDuplicates", fields: [sourcePublishedTemplateId], references: [id], onDelete: SetNull)
  duplicatedTemplates Template[]        @relation("TemplateDuplicates")
  versions            TemplateVersion[]
  projects            Project[]

  @@unique([organizationId, title])
  @@index([organizationId])
  @@index([publishedAt])
  @@map("templates")
}

// 追記型。1回の保存で7工程分まとめて新版になる。titleはテンプレート名
model TemplateVersion {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  templateId String   @map("template_id") @db.Uuid
  title      String   @db.VarChar(255)
  version    Int
  createdBy  String   @map("created_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  template          Template           @relation(fields: [templateId], references: [id], onDelete: Cascade)
  creator           User               @relation(fields: [createdBy], references: [id])
  questionTemplates QuestionTemplate[]
  promptTemplates   PromptTemplate[]
  qualityGateItems  QualityGateItem[]

  @@unique([templateId, version])
  @@map("template_versions")
}

// templateVersions 1件×7工程分のレコードを持つ（管理者編集用。版そのものはTemplateVersionが持つ）
model QuestionTemplate {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  templateVersionId String   @map("template_version_id") @db.Uuid
  stageKey          StageKey @map("stage_key")
  questions         Json

  templateVersion TemplateVersion @relation(fields: [templateVersionId], references: [id], onDelete: Cascade)

  @@unique([templateVersionId, stageKey])
  @@map("question_templates")
}

// templateVersions 1件×7工程分のレコードを持つ（管理者編集用。版そのものはTemplateVersionが持つ）
model PromptTemplate {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  templateVersionId String   @map("template_version_id") @db.Uuid
  stageKey          StageKey @map("stage_key")
  templateText      String   @map("template_text") @db.Text

  templateVersion TemplateVersion @relation(fields: [templateVersionId], references: [id], onDelete: Cascade)

  @@unique([templateVersionId, stageKey])
  @@map("prompt_templates")
}

// templateVersions 1件×7工程分のレコードを持つ（管理者編集用。版そのものはTemplateVersionが持つ）
model QualityGateItem {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  templateVersionId String   @map("template_version_id") @db.Uuid
  stageKey          StageKey @map("stage_key")
  items             Json

  templateVersion TemplateVersion @relation(fields: [templateVersionId], references: [id], onDelete: Cascade)

  @@unique([templateVersionId, stageKey])
  @@map("quality_gate_items")
}

// 案件そのもの。templateIdが参照するテンプレートは常に最新版で参照される（ライブ参照）
model Project {
  id             String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String               @map("organization_id") @db.Uuid
  name           String               @db.VarChar(255)
  templateId     String               @map("template_id") @db.Uuid
  currentStage   StageKey             @default(requirements) @map("current_stage")
  overallStatus  ProjectOverallStatus @default(in_progress) @map("overall_status")
  createdBy      String               @map("created_by") @db.Uuid
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization   @relation(fields: [organizationId], references: [id])
  template     Template       @relation(fields: [templateId], references: [id])
  creator      User           @relation(fields: [createdBy], references: [id])
  stages       ProjectStage[]

  @@index([organizationId])
  @@index([overallStatus])
  @@index([templateId])
  @@map("projects")
}

// 案件×工程の1レコード。案件作成時に7工程分まとめて作成する
model ProjectStage {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId         String             @map("project_id") @db.Uuid
  stageKey          StageKey           @map("stage_key")
  status            ProjectStageStatus @default(not_started)
  answers           Json               @default("{}")
  generatedPrompt   String?            @map("generated_prompt") @db.Text
  qualityGateResult Json               @default("{}") @map("quality_gate_result")
  completedAt       DateTime?          @map("completed_at") @db.Timestamptz

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, stageKey])
  @@index([projectId])
  @@map("project_stages")
}
